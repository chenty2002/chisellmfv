# Copy to `.env` and fill in your own credentials.
# `.env` is git-ignored. NEVER commit real API keys.
#
# The project loads this file automatically on import if present;
# environment variables take precedence over values here.

# --- Required: at least the LLM API key ---
CHISELLMFV_LLM_API_KEY=
# CHISELLMFV_EMBEDDING_API_KEY=
# CHISELLMFV_RERANKER_API_KEY=

# --- Optional endpoint / model overrides ---
# CHISELLMFV_LLM_URL=https://api.siliconflow.cn/v1/chat/completions
# CHISELLMFV_LLM_MODEL=Pro/zai-org/GLM-4.7
# CHISELLMFV_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
# CHISELLMFV_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# CHISELLMFV_RERANKER_URL=https://api.siliconflow.cn/v1/rerank
# CHISELLMFV_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# --- Legacy names are also accepted (lower precedence) ---
# LLM_API_KEY=
# EMBEDDING_API_KEY=
# RERANKER_API_KEY=
