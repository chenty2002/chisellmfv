# Copy to `.env` and fill in your own credentials.
# `.env` is git-ignored. NEVER commit real API keys.
#
# The project loads this file automatically on import if present;
# environment variables take precedence over values here.

# --- Required: at least the LLM API key ---
CHISELLMFV_LLM_API_KEY=

# --- Optional endpoint / model overrides ---
CHISELLMFV_LLM_BASE_URL=
CHISELLMFV_LLM_MODEL=
CHISELLMFV_LLM_EXTRA_BODY=
