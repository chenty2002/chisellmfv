{
  "schema_version": "specflow_project.v1",
  "project_id": "counter",
  "project_root": "benchmark/synth/counter",
  "source_roots": [
    "src/main/scala"
  ],
  "model_visible_roots": [
    "src/main/scala"
  ],
  "model_visible_files": [
    "src/main/scala/FirstCounter.scala"
  ],
  "build": {
    "kind": "sbt",
    "compile_argv": [
      "sbt",
      "--error",
      "compile"
    ],
    "overlay_source_root": "src/main/scala/chisellmfv/generated",
    "elaborate_main": "withw.counter.EmitSpecFlow",
    "generated_sv_globs": [
      "specflow-generated/**/*.sv"
    ],
    "firtool_options": [
      "--disable-all-randomization",
      "--lowering-options=disallowLocalVariables,disallowPackedArrays"
    ]
  },
  "generator": {
    "package": "withw.counter",
    "constructor": "new FirstCounter(CounterVariant(opaque, increment, overflowAtMax, resetCounter))",
    "top_name": "first_counter",
    "configuration_schema": "counter_config.v1",
    "parameter_schema": {
      "increment": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      },
      "overflowAtMax": {
        "type": "boolean"
      },
      "resetCounter": {
        "type": "boolean"
      }
    }
  },
  "formal": {
    "clock": "clock",
    "reset": "reset",
    "reset_active_high": true,
    "backend": "jaspergold"
  }
}
