{
  "schema_version": "specflow_project.v1",
  "project_id": "counter",
  "project_root": "benchmark/synth/counter",
  "source_roots": [
    "src/main/scala"
  ],
  "model_visible_roots": [
    "src/main/scala"
  ],
  "model_visible_files": [
    "src/main/scala/FirstCounter.scala"
  ],
  "model_view": {
    "strategy": "exact_copy",
    "exclusions": []
  },
  "build": {
    "kind": "sbt",
    "compile_argv": [
      "sbt",
      "--error",
      "compile"
    ],
    "overlay_source_root": "src/main/scala/chisellmfv/generated",
    "elaborate_main": "withw.counter.EmitSpecFlow",
    "generated_sv_globs": [
      "specflow-generated/**/*.sv"
    ],
    "firtool_options": [
      "--disable-all-randomization",
      "--lowering-options=disallowLocalVariables,disallowPackedArrays"
    ]
  },
  "generator": {
    "package": "withw.counter",
    "constructor": "new FirstCounter(CounterVariant(opaque, increment, overflowAtMax, resetCounter))",
    "top_name": "first_counter",
    "configuration_schema": "counter_config.v1",
    "parameter_schema": {
      "increment": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      },
      "overflowAtMax": {
        "type": "boolean"
      },
      "resetCounter": {
        "type": "boolean"
      }
    }
  },
  "formal": {
    "clock": "clock",
    "reset": "reset",
    "reset_active_high": true,
    "backend": "jaspergold"
  },
  "diagnosis": {
    "causal_backend": "verilog_causal_analysis.v2",
    "causal_policy": "best_effort",
    "clock_domain": "formal_primary",
    "max_depth": 12,
    "max_nodes": 120,
    "random_seed": 0,
    "max_model_calls": 3,
    "max_evidence_queries": 2,
    "max_source_context_lines": 5
  }
}
