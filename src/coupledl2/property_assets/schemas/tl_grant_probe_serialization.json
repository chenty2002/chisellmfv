{
  "schema_version": "property_schema.v2",
  "property_schema_id": "TL_GRANT_PROBE_SERIALIZATION",
  "category": "serialization_safety",
  "layer": "transaction",
  "title": "Grant and same-block Probe are serialized until GrantAck",
  "source": {
    "kind": "protocol_requirement",
    "document": "tilelink_spec_1.8.1",
    "locator": "tilelink_spec_1.8.1.md:1173-1175",
    "statement": "After a slave issues a Grant for a block, it should not issue Probes on that block until the corresponding GrantAck is received."
  },
  "rule_id": "TL_9_2_GRANT_PROBE_SERIALIZATION",
  "channel_scope": {"channels": ["B", "D", "E"], "message_classes": ["Grant", "GrantAck", "Probe"], "scope": "same_block"},
  "trigger_event": {"kind": "grant_pending", "description": "a Grant for a block remains outstanding", "channel": "D", "message_classes": ["Grant"]},
  "response_event": {"kind": "grant_ack", "description": "the matching GrantAck is accepted", "channel": "E", "message_classes": ["GrantAck"]},
  "matching_key": {"fields": ["set", "tag"], "semantics": "same cache block"},
  "temporal_shape": "forbid_while_pending",
  "bound": {"kind": "none", "minimum": 0, "maximum": 0},
  "preconditions": ["reset has completed", "GrantBuffer grantStatus entries identify Grants awaiting GrantAck"],
  "optional_behavior_policy": "required",
  "environment_assumptions": [],
  "required_observations": [
    {"id": "grant_pending", "role": "grant_pending", "type": "Bool", "description": "same-block Grant remains pending"},
    {"id": "probe_fire", "role": "probe_fire", "type": "Bool", "description": "same-block Probe is issued"}
  ],
  "template_ids": ["chisel3_tl_grant_probe_serialization", "chisel3_tl_grant_probe_serialization_formal_assert"],
  "review_required": true
}
