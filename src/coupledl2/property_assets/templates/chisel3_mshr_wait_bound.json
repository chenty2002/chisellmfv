{
  "schema_version": "assertion_template",
  "template_id": "chisel3_mshr_wait_bound",
  "chisel_family": "chisel3",
  "property_schema_ids": ["CL2_MSHR_WAIT_BOUND"],
  "slots": {"timer": {"type": "UInt"}},
  "parameters": {
    "bound": {"type": "integer", "minimum": 64, "maximum": 4096}
  },
  "fragments": {
    "source_block": "chisel3.util.experimental.BoringUtils.addSource(timer, s\"${cacheParams.name}_{{source_label}}_${i}\", disableDedup = true)",
    "support_block": "coupledL2.foreach { l2 =>\n  for (mshrIdx <- 0 until l2.cacheParams.mshrs) {\n    val mshrWaitTimer = WireDefault(0.U(64.W))\n    chisel3.util.experimental.BoringUtils.addSink(mshrWaitTimer, s\"${l2.cacheParams.name}_{{base_label}}_${mshrIdx}\")\n    {{ASSERTION_BLOCK}}\n  }\n}",
    "assertion_block": "assert({{timer}} <= {{bound}}.U, \"{{base_label}}\")"
  },
  "evidence_fragments": {
    "events": {"mshr_wait": "{{timer}} =/= 0.U"},
    "observers": {"timer": [{"target": "nonzero", "expression": "{{timer}} =/= 0.U"}]},
    "states": {"wait counter": [{"target": "nonzero", "expression": "{{timer}} =/= 0.U"}]},
    "assumption_guard": "true.B"
  },
  "rtl_match": {
    "source_annotation_suffix": "src/test/scala/coupledL2/VerifyTop.scala",
    "minimum_occurrences": 1,
    "allow_multiple_occurrences": true
  }
}
