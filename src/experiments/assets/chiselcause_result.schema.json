{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chiselcause_result.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "method", "status", "input_identity",
    "source_ranking", "search_trace", "work", "metrics", "runtime_seconds",
    "peak_rss_bytes", "termination_reason", "failure_reason"
  ],
  "properties": {
    "schema_version": {"const": "chiselcause_result.v2"},
    "case_id": {"type": "string"},
    "method": {"enum": ["d0", "d1", "d2", "d3"]},
    "status": {"enum": ["complete", "incomplete", "unsupported", "tool_error"]},
    "input_identity": {"type": "object"},
    "source_ranking": {"type": ["object", "null"]},
    "search_trace": {"type": ["object", "null"]},
    "work": {"type": ["object", "null"]},
    "metrics": {"type": ["object", "null"]},
    "runtime_seconds": {"type": ["number", "null"]},
    "peak_rss_bytes": {"type": ["integer", "null"]},
    "termination_reason": {"type": ["string", "null"]},
    "failure_reason": {"type": ["string", "null"]}
  }
}
